  "cards": [
    {
      "dot": "cyan",
      "title": "Cache check",
      "items": [
        "The API first embeds the question (OpenAI), then looks it up: exact normalised string, else cosine ≥ 0.75",
        "A hit streams the stored answer as one token event plus done, with no LLM calls",
        "A 'status: started' event is sent before the lookup"
      ]
    },
    {
      "dot": "rose",
      "title": "No evidence",
      "items": [
        "Hits below 0.28 cosine are dropped",
        "If nothing is left, synthesis skips the LLM and returns a fixed refusal with zero citations"
      ]
    },
    {
      "dot": "amber",
      "title": "Details",
      "items": [
        "Sub-queries are searched concurrently (asyncio.gather), then deduped in order",
        "Store search runs on a worker thread so the event loop stays free",
        "Citations are filtered to the [n] markers the answer used; errors after the 200 header arrive as an error event"
      ]
    }
  ]
