  "cards": [
    {
      "dot": "emerald",
      "title": "Cache hit",
      "items": [
        "If Redis returns a value, the API responds immediately",
        "PostgreSQL is never touched on a hit"
      ]
    },
    {
      "dot": "orange",
      "title": "Cache miss",
      "items": [
        "Redis returns nil, so the API queries PostgreSQL",
        "The result is written back to Redis with a TTL",
        "The next request for the same key is a hit"
      ]
    }
