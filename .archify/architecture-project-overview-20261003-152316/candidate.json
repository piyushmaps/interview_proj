  "cards": [
    { "dot": "cyan", "title": "Ingestion (offline)", "items": [
      "Four connectors read sample files into Document objects",
      "SHA content hash in a SQLite manifest skips unchanged docs and makes runs resumable",
      "Chunks are embedded in batches of 256 and upserted with deterministic ids (doc_id#position)",
      "Persistent embedding failures stop the run; corrupt files are skipped" ] },
    { "dot": "emerald", "title": "Answering (online)", "items": [
      "/ask checks the answer cache first: exact string, then embedding similarity ≥ 0.75",
      "Router LLM picks 1–3 sources plus optional sub-queries",
      "Retriever embeds each sub-query, searches the routed sources, drops hits below 0.28 cosine",
      "No evidence left → refusal with zero citations and no answer LLM call" ] },
    { "dot": "violet", "title": "Swappable pieces", "items": [
      "VECTOR_STORE=faiss (local file) or opensearch (docker compose, hybrid BM25 + kNN)",
      "Langfuse tracing turns on only when keys are set and never fails a request",
      "Eval harness scores routing and fact recall against data/eval/golden.json" ] }
  ]
