# LLM
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GROQ_API_KEY=gsk-your-key-here

# LangGraph / LangSmith (tracing & observability)
LANGGRAPH_API_KEY=lsv2-your-key-here
LANGSMITH_API_KEY=lsv2-your-key-here

# Slack connector
SLACK_USER_TOKEN=xoxb-your-token-here

# Jira connector
JIRA_API_TOKEN=your-jira-api-token
JIRA_INSTANCE_URL=https://your-org.atlassian.net
JIRA_USERNAME=you@example.com
JIRA_CLOUD=true

# Vector store: "opensearch" | "faiss" (local default)
VECTOR_STORE=faiss
FAISS_INDEX_PATH=data/index/faiss

# OpenSearch (when VECTOR_STORE=opensearch)
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_INDEX=capability_docs
OPENSEARCH_USE_SSL=false

# AWS (Phase 6 deployment)
AWS_REGION=us-east-1
S3_BUCKET=intuit-agentic-rag-docs
ECS_CLUSTER=intuit-agentic-rag

# App
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Vector store: faiss (local, no server) | opensearch (scale)
VECTOR_STORE=faiss
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_INDEX=capability_docs
# Fuse BM25 + vector rankings (OpenSearch only)
HYBRID_SEARCH=true

# Ingestion
EMBED_BATCH_SIZE=256
CHECKPOINT_EVERY_BATCHES=20
CSV_SMALL_SHEET_ROWS=500
CSV_MAX_TEXT_ROWS=2000
PDF_PAGES_PER_DOCUMENT=50
MIN_SIMILARITY=0.28

# Tracing (optional — absent keys simply disable it)
# Sign up at https://cloud.langfuse.com, then Settings -> API Keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
